<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Parallel Suite" parallel="tests" thread-count="4" verbose="1">

	<listeners>
		<listener class-name="com.automation.utils.ExtentTestListener" />
	</listeners>

	<test name="ChromeTests" parallel="methods" thread-count="2">
		<parameter name="browser" value="chrome" />
		<classes>
			<class name="com.automation.tests.LoginTest" />
			<class name="com.automation.tests.CheckoutFlowTest" />
			<class name="com.automation.tests.CartTest" />
			<class name="com.automation.tests.CheckoutTest" />
		</classes>
	</test>

	<test name="FirefoxTests" parallel="methods" thread-count="2">
		<parameter name="browser" value="firefox" />
		<classes>
			<class name="com.automation.tests.LoginTest" />
			<class name="com.automation.tests.CheckoutFlowTest" />
			<class name="com.automation.tests.CartTest" />
			<class name="com.automation.tests.CheckoutTest" />
		</classes>
	</test>
</suite>